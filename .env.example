# Copy to .env and fill in. Bot tab -> Reset Token in the Discord Developer Portal.
DISCORD_TOKEN=
# General Information tab -> Application ID
CLIENT_ID=
# Right-click your server -> Copy Server ID. Set this so commands appear instantly.
# Leave blank to deploy commands globally (up to ~1h to propagate).
GUILD_ID=

# Channels (defaults match the old bot; override if you like)
LOG_CHANNEL_ID=1526971616980893947
STATUS_CHANNEL_ID=1538378952140263445
ONLINE_PLAYERS_CHANNEL_ID=1538378881826824292

# Comma-separated Discord user IDs with owner-level bot access.
OWNER_IDS=

# Public URL of the Mocha server (RecNet public JSON APIs).
MOCHA_API_URL=https://amplitudeshitlol.realcat.lol
# Optional separate website URL for building recnet links. Defaults to MOCHA_API_URL.
MOCHA_RECNET_URL=

# Shared secret for the Discord->Mocha admin bridge (/link, /edit-profile).
# Must match the BOT_ADMIN_SECRET configured on the Mocha server. Leave blank to disable the bridge.
BOT_ADMIN_SECRET=
